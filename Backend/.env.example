MONGODB_URI=mongodb://127.0.0.1:27017/kickhub
SECRET_KEY=replace-with-a-long-random-secret
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
# Set only behind a reverse proxy (Render: 1) so login rate limits see the real client IP.
TRUST_PROXY=

# Set these only in Backend/.env; never expose App Secret in frontend or Git.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v25.0

# Web application OAuth client ID; Google Identity Services needs no client secret.
GOOGLE_CLIENT_ID=
